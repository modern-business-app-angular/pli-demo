{
  "name": "pli-demo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Pli — démo statique d'une application de gestion du courrier et des demandes pour collectivités (Angular 21, couche réseau simulée dans le navigateur).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:gh-pages": "ng build --configuration production,gh-pages && node scripts/postbuild-gh-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "preview": "node scripts/serve-dist.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:icons": "node scripts/check-icons.mjs",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "screenshots": "node scripts/screenshots.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "@angular/animations": "~21.2.0",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@ant-design/icons-angular": "^21.0.0",
    "@ngrx/signals": "^21.1.0",
    "driver.js": "^1.3.5",
    "msw": "^2.12.14",
    "ng-zorro-antd": "~21.2.0",
    "ngx-quill": "^30.0.1",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@eslint/js": "^9.30.0",
    "angular-eslint": "^21.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.30.0",
    "jsdom": "^26.1.0",
    "less": "^4.6.4",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.8"
  }
}
